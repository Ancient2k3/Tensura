local ws = game:GetService("Workspace")
local plrs = game:GetService("Players")
local plr = plrs.LocalPlayer
local cmds = loadstring(game:HttpGet("https://raw.githubusercontent.com/Ancient2k3/Modules/refs/heads/main/Commands.lua"))()

if #plrs:GetPlayers() == 1 then
  local ui_list = loadstring(game:HttpGet("https://raw.githubusercontent.com/Ancient2k3/Modules/refs/heads/main/Items_List.lua"))()
  local xn = game:HttpGet("https://raw.githubusercontent.com/Ancient2k3/Tensura/refs/heads/cmds/tsb_skills")
  if xn ~= nil and type(xn) == "string" then
    xn = xn:split(", ")
  end local total_moveset = 0

  function rcv_item(action, name)
    local char = plr and plr.Character
    if char then
      char.Communicate:FireServer({
        Goal = "Custom Character", Action = action,
        SkillName = name
      })
    end
  end
  
  function random_unique(count, min, max)
    local result, used = {}, {}
    while #result < count do
      local n = math.random(min, max)
      if not used[n] then
        used[n] = true
        result[#result + 1] = n
      end
    end return result
  end
  
  ui_list.add_button("CLEAR MOVESETS", function()
    local _bp = plr and plr.Backpack
    if _bp and #_bp:GetChildren() > 0 then
      for _, item_inst in next, _bp:GetChildren() do
        if item_inst:IsA("Tool") then
          rcv_item("RemoveSkillFromSelf", item_inst.Name)
          task.wait(0.2)
        end
      end
    end
  end)
  
  ui_list.add_button("RANDOM MOVESETS", function()
    local chosen_nums = random_unique(4, 1, #xn)
    if #chosen_nums >= 4 then
      for i = 1, 4 do
        rcv_item("GiveSkillToSelf", xn[chosen_nums[i]])
        task.wait(0.2)
      end
    end
  end)
  
  for i = 1, #xn do
    ui_list.add_button(xn[i], function()
      rcv_item("GiveSkillToSelf", xn[i])
    end) total_moveset = total_moveset + 1
  end ui_list.add_button("Movesets count: " .. tostring(total_moveset) .. ".", function()
    print("[Total Movesets: " .. tostring(total_moveset) .. ". ]")
  end)
end

cmds.addcmd("afk", {"afk", "ai"}, "load afk AI, automatically fight for u", function()
  loadstring(game:HttpGet("https://raw.githubusercontent.com/Ancient2k3/Tensura/refs/heads/place/TSB_MODULES/Auto-Battle%3AAI/MODEL_D4.lua"))()
  --cmds.core_notify("AI Script Loaded...")
end)

cmds.addcmd("music", {"music", "m"}, "play some music", function(name, looped)
  local fldr, rslt = ws.HHxScripts.Assets.Audios, nil
  for _, v in next, fldr:GetChildren() do
    if v:IsA("Sound") then v:Pause() end
    if v:IsA("Sound") and v.Name:lower():match(name) then
      rslt = v
      break
    end
  end if rslt then
    rslt:Play()
    if looped then print(typeof(looped), looped) end
  end
end)
