local plrs = game:GetService("Players")
local plr = plrs.LocalPlayer
local cmds = loadstring(game:HttpGet("https://raw.githubusercontent.com/Ancient2k3/Modules/refs/heads/main/Commands.lua"))()

cmds.addcmd("afk", {"afk", "ai"}, "load afk AI, automatically fight for u", function()
  loadstring(game:HttpGet("https://raw.githubusercontent.com/Ancient2k3/Tensura/refs/heads/place/TSB_MODULES/Auto-Battle%3AAI/MODEL_D4.lua"))()
  --cmds.core_notify("AI Script Loaded...")
end)

cmds.addcmd("skill", {"skill", "gs"}, "get some skill, available ability... etc", function(...)
  local char = plr and plr.Character
  if char and char:FindFirstChild("Communicate") then
    char.Communicate:FireServer({SkillName = ..., Goal = "Custom Character", Action = "GiveSkillToSelf"})
  end
end)
